# Copy to .env and fill in. Names only; never commit values.
# URL-safe characters only (letters, digits, - _ . ~): it goes into DATABASE_URL as is.
POSTGRES_PASSWORD=
# Used by `cd server && npm test` (database name must end in _test):
# TEST_DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5432/web2_test
TEST_DATABASE_URL=
# Optional: the prod SDK key printed by the seed, so the local server serves P1 at
# http://127.0.0.1:3000/p1/ (D-015). Public, but per database, so not committed.
P1_SDK_KEY=
